# Copy these settings into the application's existing .env file.
# Replace the database/user/password placeholders with your MySQL credentials.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aadi
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD="YOUR_DB_PASSWORD"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
