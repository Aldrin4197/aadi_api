APP_NAME=Aadi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Hostinger email (smtp.hostinger.com). Implicit TLS on 465 uses MAIL_SCHEME=smtps;
# for port 587 (STARTTLS) set MAIL_PORT=587 and MAIL_SCHEME=smtp. The sender must be the mailbox itself.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@aadirentals.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@aadirentals.com"
MAIL_FROM_NAME="Aadi"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public, URL-restricted Mapbox token; matches Flutter's light-v11 basemap.
VITE_MAPBOX_TOKEN=
# Optional alternative raster provider (takes precedence over Mapbox).
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Official Aadi store listing URLs. Leave blank until the app is available.
AADI_GOOGLE_PLAY_URL=
AADI_APP_STORE_URL=
